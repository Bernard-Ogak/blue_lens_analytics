<?xml version="1.0"?>
<ruleset name="Blue Lens Analytics">
	<description>WordPress Coding Standards for Blue Lens Analytics.</description>

	<file>./blue-lens-analytics.php</file>
	<file>./uninstall.php</file>
	<file>./src</file>
	<file>./tests</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.4"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress">
		<!-- PSR-4 class files (src/Core/Settings.php) instead of class-settings.php. -->
		<exclude name="WordPress.Files.FileName"/>
		<!-- PHP 8.1 codebase: short array syntax is used throughout. -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<!-- Events live in custom tables by design; queries are prepared and cached where they are read often. -->
		<exclude name="WordPress.DB.DirectDatabaseQuery"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="blue-lens-analytics"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="blue_lens"/>
				<element value="bla"/>
				<element value="BlueLens\Analytics"/>
			</property>
		</properties>
	</rule>

	<!-- dbDelta CREATE TABLE statements interpolate trusted table names; everything else uses %i. -->
	<rule ref="WordPress.DB.PreparedSQL.InterpolatedNotPrepared">
		<exclude-pattern>/src/Core/Migrations/*</exclude-pattern>
	</rule>
</ruleset>
